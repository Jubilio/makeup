{
  "name": "inuka-loja",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "catalog": "python3 scripts/build_catalog.py",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply aneka-shop --local",
    "db:migrate": "wrangler d1 migrations apply aneka-shop --remote"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "5.8.3",
    "wrangler": "^4.157.0"
  }
}
